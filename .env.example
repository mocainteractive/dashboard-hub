# --- Moca Hub ---
# URL dell'Hub (SDK e start-session lo usano per validare i launch token).
VITE_MOCA_HUB_URL=https://moca-central-hub.netlify.app
# MOCA_HUB_URL=https://moca-central-hub.netlify.app

# --- Solo Netlify Functions (server-side, MAI esposte al browser) ---
# Cifratura della sessione dell'app (obbligatoria). Stringa casuale lunga:
#   openssl rand -hex 32
SESSION_SECRET=

# Widget di Feedback: stessa chiave Resend dell'Hub.
RESEND_API_KEY=

# Server MCP di Moca (stessi valori dell'app Onboarding Data Lake): indirizzo
# del connettore con il token (.../mcp/<token>, oppure .../mcp?key=<chiave>
# per Pinterest). In alternativa URL che finisce con /mcp e MCP_<X>_TOKEN.
# Ogni server è facoltativo: senza, la piattaforma non è interrogabile.
MCP_GA4_URL=
MCP_GSC_URL=
MCP_GADS_URL=
MCP_META_URL=
MCP_PINTEREST_URL=

# NON vanno su Netlify: arrivano dall'Hub, per cliente.
#   DATA_LAKE_CLIENT_JSON  contenuto di clients/<slug>.json (app Onboarding Data Lake)
#   ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
#   AI_MODEL_ANTHROPIC / AI_MODEL_OPENAI / AI_MODEL_GEMINI  (facoltativi, per cambiare modello)

# --- Solo sviluppo locale con `netlify dev` (MAI su Netlify) ---
# DEV_DATA_LAKE_CLIENT_JSON={"client_id":"cliente_demo","sources":{"meta_ads":[{"account_id":"act_123","valid_from":"2020-01-01"}]}}
# DEV_ANTHROPIC_API_KEY=
# DEV_OPENAI_API_KEY=
# DEV_GEMINI_API_KEY=
