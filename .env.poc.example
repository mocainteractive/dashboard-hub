# --- POC locale di Dashboard Hub (npm run poc) ---
# Copia questo file in .env.poc e compila i valori. .env.poc non va su git.
# Nessun deploy Netlify: app e API girano sul tuo computer.

# Cliente da provare: percorso del JSON prodotto da Onboarding Data Lake
# (clients/<slug>.json). In alternativa DEV_DATA_LAKE_CLIENT_JSON con il JSON su una riga.
POC_CLIENT_FILE=./clients/nome-cliente.json
# DEV_DATA_LAKE_CLIENT_JSON={"client_id":"cliente_demo","sources":{"ga4":[{"property_id":"123456789","valid_from":"2020-01-01"}]}}

# Chiave Anthropic (Claude).
POC_ANTHROPIC_API_KEY=

# Facoltativi: modello e sforzo di ragionamento (low, medium, high, xhigh, max).
# Predefiniti: claude-opus-5-5, medium. Per risposte più rapide prova claude-sonnet-5-5 o AI_EFFORT=low.
# AI_MODEL_ANTHROPIC=claude-opus-5-5
# AI_EFFORT=medium

# Server MCP di Moca: stessi valori di Netlify / Onboarding Data Lake.
MCP_GA4_URL=
MCP_GSC_URL=
MCP_GADS_URL=
MCP_META_URL=
MCP_PINTEREST_URL=

# Facoltativi.
# POC_PORT=5180
# POC_USER_NAME=Tester POC
# POC_DATA_DIR=.poc-data
